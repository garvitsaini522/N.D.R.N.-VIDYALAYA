# ==============================================================================
# N.D.R.N. VIDYALAYA FRONTEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env, .env.local, or .env.production and configure accordingly.
# ==============================================================================

# Backend API Base URL
#
# Option A: Local Development (Direct backend port)
VITE_API_URL=http://localhost:5000/api

# Option B: Local Development with Vite Proxy
# If VITE_API_URL is omitted or set to '/api', Vite development server automatically
# proxies all /api requests to http://localhost:5000/api without CORS issues.
# VITE_API_URL=/api

# Option C: Production Deployment
# Set to the canonical HTTPS domain of your backend API:
# VITE_API_URL=https://api.ndrnvidyalaya.edu.in/api
#
# Or if frontend and backend share the same domain / reverse proxy:
# VITE_API_URL=/api
