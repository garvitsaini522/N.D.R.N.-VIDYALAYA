# ==============================================================================
# N.D.R.N. VIDYALAYA BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and configure with your environment values.
# NEVER commit real credentials, database passwords, or JWT secrets to Git.
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection URI
# Local MongoDB example:
MONGODB_URI=mongodb://127.0.0.1:27017/ndrn_vidyalaya
# MongoDB Atlas Cloud example:
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/ndrn_vidyalaya?retryWrites=true&w=majority

# JWT Authentication Configuration
# In production, use a strong random 256-bit string (e.g., generated with: openssl rand -base64 32)
JWT_SECRET=your_secure_random_jwt_secret_here
JWT_EXPIRES_IN=7d

# Initial Administrator Bootstrap Setup Key
# Used strictly to create the initial admin account via POST /api/auth/register or header x-admin-setup-key
ADMIN_SETUP_KEY=your_secure_admin_bootstrap_key_here

# CORS Allowed Origins (Comma-separated for multiple origins)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# API Rate Limiting (Maximum requests per IP per 15-minute window)
RATE_LIMIT_MAX=300

