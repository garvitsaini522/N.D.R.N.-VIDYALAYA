# ==============================================================================
# N.D.R.N. VIDYALAYA BACKEND ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env, .env.development, or .env.production and configure.
#
# CRITICAL SECURITY RULES:
# 1. NEVER commit real credentials, database passwords, or secret keys to Git.
# 2. In production, JWT_SECRET and ADMIN_SETUP_KEY must be distinct, independently
#    generated high-entropy cryptographic strings.
# 3. Production startup will automatically reject template placeholders, defaults,
#    or unauthenticated localhost database connections.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server Configuration
# ------------------------------------------------------------------------------
PORT=5000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 2. Database Connection
# ------------------------------------------------------------------------------
# Development (Local unauthenticated MongoDB):
MONGODB_URI=mongodb://127.0.0.1:27017/ndrn_vidyalaya

# Production (Authenticated MongoDB Replica Set or Cloud Atlas):
# In production, MONGODB_URI is required and must not point to localhost.
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/ndrn_vidyalaya?retryWrites=true&w=majority

# ------------------------------------------------------------------------------
# 3. Authentication & Security Secrets
# ------------------------------------------------------------------------------
# JWT Authentication Secret
# In production: Required, minimum 32 characters (256-bit entropy).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_secure_random_jwt_secret_here
JWT_EXPIRES_IN=7d

# Initial Administrator Bootstrap Setup Key
# Used strictly to authorize initial admin registration (POST /api/auth/register or x-admin-setup-key).
# In production: Required, minimum 16 characters, must be distinct from JWT_SECRET.
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_SETUP_KEY=your_secure_admin_bootstrap_key_here

# ------------------------------------------------------------------------------
# 4. CORS Allowed Origins
# ------------------------------------------------------------------------------
# Comma-separated list of authorized frontend origins.
# In production, CORS_ORIGIN is mandatory and cannot contain wildcards (*).
#
# Development:
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
#
# Production:
# CORS_ORIGIN=https://ndrnvidyalaya.edu.in,https://www.ndrnvidyalaya.edu.in

# ------------------------------------------------------------------------------
# 5. Rate Limiting
# ------------------------------------------------------------------------------
# Maximum requests per IP per 15-minute window (default: 300)
RATE_LIMIT_MAX=300

# ------------------------------------------------------------------------------
# 6. Payment Gateway Integration (Optional)
# ------------------------------------------------------------------------------
# When omitted or left empty, online fee payment is safely disabled, and the portal
# clearly directs parents and students to make offline payments at the school cash counter.
#
# Supported providers: razorpay, payu
# PAYMENT_GATEWAY_PROVIDER=razorpay
# PAYMENT_GATEWAY_KEY_ID=your_payment_gateway_key_id
# PAYMENT_GATEWAY_KEY_SECRET=your_payment_gateway_key_secret
# PAYMENT_GATEWAY_WEBHOOK_SECRET=your_payment_gateway_webhook_secret

# ------------------------------------------------------------------------------
# 7. Initial Admin Provisioning CLI (Optional)
# ------------------------------------------------------------------------------
# Used when running `node scripts/createAdmin.js` without interactive CLI arguments.
# INITIAL_ADMIN_NAME=School Administrator
# INITIAL_ADMIN_EMAIL=admin@ndrnvidyalaya.edu.in
# INITIAL_ADMIN_PASSWORD=your_initial_admin_password_here
# INITIAL_ADMIN_PHONE=919876543210
